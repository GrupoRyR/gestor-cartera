# Gestor de cartera: environment template.
# Copy it to .env and fill in the values. Never commit .env: credentials live
# only there. Every variable the project expects is listed here (C.2).

APP_NAME="Gestor de cartera"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Bogota

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Logs: daily files kept 14 days (shared hosting has no log rotation).
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database. Local: SQLite (database/database.sqlite). Production (GoDaddy
# cPanel) and CI: MySQL 8. In production, comment SQLite and fill MySQL.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=gestor_cartera
# DB_USERNAME=
# DB_PASSWORD=

# Sessions, cache and queues use the database: shared hosting has no Redis and
# no supervisor (cPanel cron runs schedule:run every minute, see routes/console.php).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production: true, so the session cookie only travels over HTTPS.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Laravel's own mailer, for framework messages only. Business email (weekly
# collections, circularization, alerts) goes through Microsoft Graph (GRAPH_*).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- Sign-in with Microsoft Entra ID (Core, Laravel Socialite) ----------------
# App registration for user sign-in (delegated permissions: openid, profile,
# email, User.Read). Pending with TI: Part D #7. The redirect URI must match
# the one registered in Entra ID.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI="${APP_URL}/auth/microsoft/callback"

# --- Microsoft Graph for the company mailboxes (Cobro) ------------------------
# Separate app registration (app-only). TI grants Mail.Send and
# Mail.ReadWrite through RBAC for Applications in Exchange Online, scoped to
# the two mailboxes below, never as tenant-wide Entra ID grants (those would
# open every mailbox). Pending with TI: Part D #6 and #7.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
COBRO_MAILBOX_SGX=segurex.info@segurex.com
COBRO_MAILBOX_SDC=derivados.info@derivadoscol.com

# --- Robot ingestion endpoint (Ingesta) ---------------------------------------
# POST /api/ingesta/{lote} is signed with HMAC-SHA256 and rotating keys:
# comma-separated "key-id:secret" pairs. The robot sends the key id with each
# request. To rotate: add the new pair, update the robot, remove the old pair.
INGESTA_HMAC_KEYS=
# Maximum clock difference accepted on signed requests, in seconds.
INGESTA_HMAC_MAX_SKEW=300
# Alert TI and the manager when the robot has not published by this time (America/Bogota).
INGESTA_ALERT_DEADLINE=07:00
# Comma-separated recipients of that alert.
INGESTA_ALERT_RECIPIENTS=

# --- Bank movements and collections (Bancos) ----------------------------------
# Folder, relative to storage/app, where bank statement files are dropped.
BANCOS_IMPORT_PATH=bancos/entrada
# Bearer token for Tesorería's app: GET /api/recaudo and the future movements
# API. Use a long random value per environment.
BANCOS_API_TOKEN=
