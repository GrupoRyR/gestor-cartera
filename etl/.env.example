# ==========================================================================
#  GESTOR DE CARTERA - Configuracion del robot ETL (SAP HANA -> Laravel)
#  Copia este archivo como  .env  y rellena los valores reales.
#  El archivo .env NUNCA se sube a Git (ya esta en .gitignore).
#  Guia completa: etl/README.md
# ==========================================================================

# --- 1. VPN Sophos Connect -------------------------------------------------
SOPHOS_CLI=C:\Program Files (x86)\Sophos\Connect\sccli.exe
SOPHOS_CONNECTION=20.186.106.194
SOPHOS_USER=
SOPHOS_PASSWORD=
# Segundos de espera a que el tunel levante antes de rendirse
SOPHOS_TIMEOUT=90
# Desconectar la VPN al terminar el ETL (true recomendado en servidor dedicado)
SOPHOS_DISCONNECT_AL_FINAL=true

# --- 2. SAP HANA -----------------------------------------------------------
HANA_HOST=
HANA_PORT=30015
HANA_USER=
HANA_PASSWORD=
# Esquema de la base de datos de SAP Business One (ej: SBO_SEGUREX)
HANA_SCHEMA=
# Segundos maximos para la consulta
HANA_TIMEOUT=600

# --- 3. Destino Laravel (gestor de cartera) - destino principal ------------
# Raiz del sitio, sin /api. El robot publica en {INGESTA_URL}/api/ingesta/{lote}.
# Debe ser https:// (http:// solo se acepta para un Laravel local).
INGESTA_URL=
# Par de la llave HMAC: debe existir en INGESTA_HMAC_KEYS del .env de Laravel
# como  <INGESTA_KEY_ID>:<INGESTA_SECRET>. Para rotarla, mira etl/README.md.
INGESTA_KEY_ID=
INGESTA_SECRET=
# Empresa de los datos: SGX (Segurex) o SDC (Soluciones y Derivados)
INGESTA_EMPRESA=SGX
# Segundos de espera por cada envio
INGESTA_TIMEOUT=120
# Comprimir el cuerpo con gzip (recomendado)
INGESTA_GZIP=true

# Lotes que se extraen y publican, separados por comas.
# Otros lotes disponibles: contactos, ventas, recaudos, cruces,
# maestro_clientes, maestro_vendedores. Agregalos solo despues de validar su
# consulta con datos reales (python etl/run_etl.py --diagnostico --lotes ventas);
# mira etl/README.md.
ETL_LOTES=cartera,asesores

# --- 4. Supabase / Postgres (respaldo del portal anterior) -----------------
# Respaldo mientras siga vivo el portal anterior: si se deja vacio, el robot
# solo publica en Laravel. Recibe cartera y asesores, como antes.
# Cadena de conexion "Session pooler" o "Direct connection" de Supabase.
# Supabase -> Project Settings -> Database -> Connection string -> URI
SUPABASE_DB_URL=

# Solo para scripts/crear_cuentas.py (alta de cuentas de acceso).
# La service_role key salta la seguridad por filas: vive UNICAMENTE en este
# archivo local, nunca en Vercel ni en el navegador.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- 5. Alertas de error (opcional) ---------------------------------------
# Si se dejan vacias, los errores solo quedan en el log y en el estado local.
ALERTA_SMTP_HOST=
ALERTA_SMTP_PORT=587
ALERTA_SMTP_USER=
ALERTA_SMTP_PASSWORD=
ALERTA_DESTINATARIOS=
