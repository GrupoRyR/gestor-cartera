# ==========================================================================
#  CARTERA WEB - Configuracion del robot ETL
#  Copia este archivo como  .env  y rellena los valores reales.
#  El archivo .env NUNCA se sube a Git (ya esta en .gitignore).
# ==========================================================================

# --- 1. VPN Sophos Connect -------------------------------------------------
SOPHOS_CLI=C:\Program Files (x86)\Sophos\Connect\sccli.exe
SOPHOS_CONNECTION=20.186.106.194
SOPHOS_USER=
SOPHOS_PASSWORD=
# Segundos de espera a que el tunel levante antes de rendirse
SOPHOS_TIMEOUT=90
# Desconectar la VPN al terminar el ETL (true recomendado en servidor dedicado)
SOPHOS_DISCONNECT_AL_FINAL=true

# --- 2. SAP HANA -----------------------------------------------------------
HANA_HOST=
HANA_PORT=30015
HANA_USER=
HANA_PASSWORD=
# Esquema de la base de datos de SAP Business One (ej: SBO_SEGUREX)
HANA_SCHEMA=
# Segundos maximos para la consulta
HANA_TIMEOUT=600

# --- 3. Supabase / Postgres (destino en la nube) ---------------------------
# Cadena de conexion "Session pooler" o "Direct connection" de Supabase.
# Supabase -> Project Settings -> Database -> Connection string -> URI
SUPABASE_DB_URL=

# Solo para scripts/crear_cuentas.py (alta de cuentas de acceso).
# La service_role key salta la seguridad por filas: vive UNICAMENTE en este
# archivo local, nunca en Vercel ni en el navegador.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- 4. Alertas de error (opcional) ---------------------------------------
# Si se dejan vacias, los errores solo quedan en el log y en la tabla etl_runs.
ALERTA_SMTP_HOST=
ALERTA_SMTP_PORT=587
ALERTA_SMTP_USER=
ALERTA_SMTP_PASSWORD=
ALERTA_DESTINATARIOS=
