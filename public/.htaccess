# No directory listings, with or without mod_negotiation.
Options -Indexes

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews
    </IfModule>

    RewriteEngine On

    # Plain http goes to https. X-Forwarded-Proto covers a TLS proxy in front
    # of the host; .well-known stays on http because cPanel AutoSSL validates
    # its certificates there.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteCond %{REQUEST_URI} !^/\.well-known/
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Dotfiles and dot folders (.env, .git, .htaccess, build/.vite) are never
    # served; .well-known is the only exception.
    RewriteRule (^|/)\.(?!well-known/) - [F,L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# The web app manifest is JSON; Apache does not know the extension by default.
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
</IfModule>

# Compress text responses (pages, styles, scripts, JSON, SVG, manifest).
# Fonts (woff2) and images are already compressed.
# AddOutputFilterByType comes from mod_filter on Apache 2.4: guard both, or a
# host without mod_filter would answer 500 to every request.
<IfModule mod_deflate.c>
    <IfModule mod_filter.c>
        AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml
    </IfModule>
</IfModule>

# Vite writes every built file to /build/assets/ with a content hash in its
# name (the fonts too), so a new build means a new URL: cache for a year.
# SetEnvIf + env= works on any Apache version (no <If> block).
<IfModule mod_setenvif.c>
    SetEnvIf Request_URI "/build/assets/" HASHED_ASSET
</IfModule>

<IfModule mod_headers.c>
    # Security headers on every response, the app's pages included. "always"
    # also covers redirects and errors. HSTS goes out only over https and
    # without includeSubDomains: other subdomains of the company are not ours.
    # The Content-Security-Policy comes from the app (it needs a nonce).
    Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"

    # Do not tell which PHP version runs the app. PHP adds the header to the
    # success table, so unset it in both.
    Header always unset X-Powered-By
    Header unset X-Powered-By

    Header set Cache-Control "public, max-age=31536000, immutable" env=HASHED_ASSET

    # The service worker and the manifest keep their names: always revalidate,
    # so a deploy reaches installed apps.
    <FilesMatch "^(sw\.js|manifest\.webmanifest)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
